[Unit]
Description=pash user portal
After=network-online.target pash-node.service
Wants=pash-node.service

[Service]
User=pash-portal
Group=pash-portal
WorkingDirectory=/opt/pash-portal
EnvironmentFile=/etc/pash-portal/portal.env
ExecStart=/opt/pash-ai/runtime/node /opt/pash-portal/server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
StateDirectory=pash-portal
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
