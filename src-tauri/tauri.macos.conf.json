{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "io.github.kuan-er.pash",
  "productName": "pash",
  "bundle": {
    "targets": ["app", "dmg"],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "13.5",
      "exceptionDomain": "",
      "signingIdentity": "-",
      "entitlements": "packages/macos/entitlements.plist",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "height": 400,
          "width": 660
        },
        "windowPosition": {
          "x": 200,
          "y": 180
        }
      },
      "infoPlist": "packages/macos/info_merge.plist"
    },
    "externalBin": [
      "sidecar/verge-mihomo",
      "sidecar/verge-mihomo-alpha",
      "sidecar/network-agent-node"
    ]
  }
}
